{
    "manifest_version": 3,
    "name": "Block Extension MVP",
    "version": "1.0.0",
    "description": "A block-based extension to interact with input fields.",
    "permissions": [
        "storage",
        "contextMenus",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "options_page": "src/options/options.html",
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.ts"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {}
}